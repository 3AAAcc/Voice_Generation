# macOS / editor noise
.DS_Store
.AppleDouble
.LSOverride
._*

# Python caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment files
.env
.env.*
!.env.example

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo

# Runtime uploads and generated outputs
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# Local model weights and large inference assets
pretrained_models/
*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.bin

# Large media artifacts generated during experiments
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.aac
*.mp4
*.mov

# Keep checked-in prompt assets explicitly when needed
!assets/prompts/*.wav
!assets/prompts/*.mp3
!assets/prompts/*.m4a
!assets/prompts/*.flac

# Local Codex / brainstorming artifacts
.codex/
.superpowers/brainstorm/manual-ui/

# Node/package manager noise if frontend tooling is added later
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test or local server artifacts
.cache/
.dist/
dist/
build/
